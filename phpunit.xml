<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Suita opisuje KRAMIO — pełną platformę. Wpis jest tu, bo instalacja
            dedykowana ma w swoim `.env` `SHOP_MODE=dedicated`, a bez wymuszenia
            wartość wyciekłaby do testów i setki asercji zaczęłyby sprawdzać
            sklep jednego klienta zamiast platformy.

            Zachowania trybu dedykowanego testujemy JAWNIE, ustawiając
            `config()->set('shop.mode', Mode::DEDICATED)` w konkretnym teście —
            patrz Tests\Feature\DedicatedModeTest.
        -->
        <env name="SHOP_MODE" value="saas"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            Log W POWIETRZE, a nie na dysk. Bez tego wpisu testy pisały domyślnym
            kanałem do `storage/logs/laravel-<dziś>.log` — tego samego pliku, który
            na produkcji liczy PlatformHealth::recentErrors(). Ekran „Błędy w logach"
            w Ustawieniach admina pokazywał więc awarie w dniach, w których nic się
            nie stało: 6 wpisów z 28.09.2026 to w całości strażnik kopii ze suity.

            To nie kosmetyka. Ekran diagnostyczny, który woła o pomoc po każdym
            przebiegu testów, przestaje być czytany — a wtedy prawdziwa awaria
            utonie w szumie. Osobno: testy nie mają prawa dotykać plików produkcji
            (incydent 04.08.2026).

            Nic nie tracimy: żaden test nie zależy od tego, że domyślny kanał pisze
            na dysk. SlowQueryLoggingTest mockuje fasadę `Log`, a wyjątek z nieudanego
            testu i tak pokazuje PHPUnit. Do debugowania konkretnego testu wystarczy
            tymczasowo zdjąć tę linijkę.
        -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Bramka platformy (opłaty za pakiety Kramio). Wartość zastępcza, bo
            testy nie wychodzą do sieci — pilnuje tego Http::preventStrayRequests().
            Bez tego wpisu ekran „Mój pakiet" nie renderuje przycisków zakupu i
            przedłużenia (PackageController: `filled(...api_key)`), więc pięć
            testów pada na świeżej instalacji bez naszego `.env` — a przyczyna
            wygląda wtedy na błąd w kodzie, nie na brak konfiguracji.
        -->
        <env name="PAYNOW_PLATFORM_API_KEY" value="test-platform-api-key"/>
        <env name="PAYNOW_PLATFORM_SIGNATURE_KEY" value="test-platform-signature-key"/>
        <!--
            Kopie zapasowe WŁĄCZONE w testach. Sprawdzamy nimi wyłącznie to, czy
            zadania są zarejestrowane w harmonogramie — nic się nie wykonuje.
            Wpis jest tu, bo instalacja robocza czy dedykowana bywa uruchamiana
            z `BACKUP_ENABLED=false`, a wtedy cztery testy harmonogramu padają
            z powodu konfiguracji środowiska, nie z powodu kodu.
        -->
        <env name="BACKUP_ENABLED" value="true"/>
    </php>
</phpunit>
