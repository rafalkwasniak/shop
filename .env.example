APP_NAME=Kramio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kramio.pl
APP_DOMAIN=kramio.pl
SHOP_MODE=saas

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DISCORD_WEBHOOK_URL=

AI_MAX_USES_PER_FIELD=3

MF_WHITELIST_URL=https://wl-api.mf.gov.pl

GUS_REGON_KEY=
GUS_REGON_URL=https://wyszukiwarkaregon.stat.gov.pl

# Fakturownia (faktury VAT). URL = adres konta, np. https://twojadomena.fakturownia.pl
# Token per-sklep trafi do shop_integrations; ten globalny = integracja platformy/SaaS.
FAKTUROWNIA_URL=
FAKTUROWNIA_TOKEN=

# InPost Geowidget v5 (mapa wyboru paczkomatu). Token platformy, wygenerowany
# w manager.paczkomaty.pl na domenę *.kramio.pl — obsługuje wszystkie storefronty.
# Jest publiczny (trafia do HTML); chroni go dowiązanie do domeny, nie tajność.
INPOST_GEOWIDGET_TOKEN=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sklep@kramio.pl"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_OUTBOX_BATCH_SIZE=20
MAIL_OUTBOX_MAX_ATTEMPTS=3
MAIL_OUTBOX_RETRY_DELAY_MINUTES=5

# Kod z maila przy logowaniu do centrali. false = wylacznik awaryjny (np. padl SMTP).
LOGIN_TWO_FACTOR=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI ---
# Klucz dostawcy (config/ai.php -> providers.deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Ustawienia domyslne dziedziczone przez zadania (config/ai.php -> defaults).
# Model konkretnego zadania nadpisuje sie w config/ai.php, nie tutaj.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash
AI_REASONING_EFFORT=low
AI_TIMEOUT=120
AI_STREAMING=true

# Paynow konta PLATFORMY (oplaty za pakiety Kramio)
PAYNOW_PLATFORM_API_KEY=
PAYNOW_PLATFORM_SIGNATURE_KEY=
PAYNOW_PLATFORM_ENVIRONMENT=sandbox

# Google Analytics — statystyki CENTRALI. Puste = pomiar wylaczony.
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# Kopie zapasowe: baza + zdjecia + .env do katalogu POZA katalogiem domeny.
# BACKUP_PATH musi byc sciezka bezwzgledna; pusta przy wlaczonych kopiach = blad.
# BACKUP_DAILY_AT: godziny przebiegu po przecinku (dwie kopie na dobe).
BACKUP_ENABLED=true
BACKUP_PATH=
BACKUP_RETENTION_DAYS=14
BACKUP_DAILY_AT=04:00,16:00
PRODUCT_IMAGE_MAX_PER_PRODUCT=8
